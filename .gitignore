# Internal planning and agent working data must not enter the public repository.
/plans/
/.agent_cache/
!/docs/

# Local secrets and Python build artifacts must never be committed.
/secrets/
.venv/
__pycache__/
# Coverage data and reports are generated by test runs.
.coverage
coverage/
node_modules/
frontend/dist/

# Browser automation artifacts from local testing.
.playwright-mcp/

*.md
!README.md
!CHANGELOG.md
!SECURITY.md
!/gateway/README-TLS.md
!ROADMAP.md
!CONTRIBUTING.md
!CODE_OF_CONDUCT.md
!/.github/**/*.md
!/docs/user-guide/*.md

# Documentation site: built output, dependencies, and documents copied from the repository root at build time.
/website/node_modules/
/website/build/
/website/.docusaurus/
/website/docs/
